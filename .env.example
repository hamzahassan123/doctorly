# Copy to .env for local development. All values below are placeholders only.
# Never commit populated .env files or use these example values in production.

# Local backend/database
DOCTORLY_DATABASE_URL=postgresql+psycopg://doctorly:local_only_change_me@localhost:5432/doctorly
POSTGRES_DB=doctorly
POSTGRES_USER=doctorly
POSTGRES_PASSWORD=local_only_change_me
DOCTORLY_JWT_SECRET_KEY=EXAMPLE_ONLY_REPLACE_WITH_RANDOM_SECRET_32_BYTES_MINIMUM
DOCTORLY_JWT_ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# LLM provider. Gemini is the configured default.
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=EXAMPLE_ONLY_gemini_api_key
GOOGLE_API_KEY=EXAMPLE_ONLY_google_api_key
OPENAI_API_KEY=EXAMPLE_ONLY_openai_api_key
GROQ_API_KEY=EXAMPLE_ONLY_groq_api_key

# LangSmith tracing is off by default. Traces may contain user prompts.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=EXAMPLE_ONLY_langsmith_api_key
LANGSMITH_PROJECT=doctorly-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OpenTelemetry and structured application logging
OTEL_SERVICE_NAME=doctorly-api
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# Optional outbound appointment email (SMTP). Leave example credentials unused.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=EXAMPLE_ONLY_smtp_username
SMTP_PASSWORD=EXAMPLE_ONLY_smtp_password
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@example.invalid

# AWS deployment / GitHub Actions configuration.
# Prefer GitHub Actions OIDC and AWS IAM roles over long-lived access keys.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ROLE_TO_ASSUME=arn:aws:iam::123456789012:role/doctorly-github-deploy
AWS_ACCESS_KEY_ID=EXAMPLE_ONLY_DO_NOT_USE_STATIC_KEYS
AWS_SECRET_ACCESS_KEY=EXAMPLE_ONLY_DO_NOT_USE_STATIC_KEYS
AWS_SESSION_TOKEN=EXAMPLE_ONLY_DO_NOT_USE_STATIC_KEYS
ECR_BACKEND_REPOSITORY=doctorly-api
ECR_FRONTEND_REPOSITORY=doctorly-frontend
VITE_API_URL=http://localhost:8000

# Production runtime secrets must come from Secrets Manager / Parameter Store,
# not this file. Provider settings above are the local-development examples.
